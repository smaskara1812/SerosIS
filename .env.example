# ── LLM Provider: "ollama" or "gemini" ────────────────────────────────────────
LLM_PROVIDER=gemini

# ── Gemini (chat only) ────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-2.5-flash

# ── Local embeddings (used when LLM_PROVIDER=gemini) ─────────────────────────
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2

# ── Ollama (used when LLM_PROVIDER=ollama) ────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── RAG / LLM tuning ──────────────────────────────────────────────────────────
# Past messages sent to the LLM per request. Keep low for Ollama (small context).
# Set to 0 for unlimited (Gemini only).
CHAT_HISTORY_WINDOW=10

# Child chunks retrieved; their parent chunks are passed to the LLM.
RETRIEVER_K=15

# Child chunk: small, used for embedding precision during retrieval.
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=50

# Parent chunk: large, passed to the LLM as full context.
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=200

# ── Database engine: set exactly one to true ──────────────────────────────────
USE_MYSQL=true
USE_MSSQL=false

# ── MySQL (local dev — converted from MSSQL dump) ─────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=seros
MYSQL_USER=root
MYSQL_PASSWORD=

# ── MSSQL (SQL Server — production) ──────────────────────────────────────────
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=seros
MSSQL_USER=
MSSQL_PASSWORD=
# Run `odbcinst -q -d` to list installed ODBC drivers on your machine
MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ── Chat History DB — MySQL ───────────────────────────────────────────────────
CHAT_MYSQL_HOST=localhost
CHAT_MYSQL_PORT=3306
CHAT_MYSQL_DB=SerosIS
CHAT_MYSQL_USER=root
CHAT_MYSQL_PASSWORD=

# ── Chat History DB — MSSQL ───────────────────────────────────────────────────
CHAT_MSSQL_HOST=localhost
CHAT_MSSQL_PORT=1433
CHAT_MSSQL_DB=SerosIS
CHAT_MSSQL_USER=
CHAT_MSSQL_PASSWORD=
CHAT_MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
