# --- Provider: "ollama" or "gemini" ---
LLM_PROVIDER=gemini

# --- Gemini (chat only) ---
GEMINI_API_KEY= 
# GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
# --- Local embeddings (used when LLM_PROVIDER=gemini) ---
LOCAL_EMBED_MODEL=all-MiniLM-L6-v2

# --- Ollama (used when LLM_PROVIDER=ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── RAG / LLM tuning ──────────────────────────────────────────────────────────
# Past messages sent to the LLM per request. Keep low for Ollama (small context).
# Set to 0 for unlimited (Gemini only).
CHAT_HISTORY_WINDOW=10

# Child chunks retrieved; their parent chunks are passed to the LLM.
RETRIEVER_K=15

# Child chunk: small, used for embedding precision during retrieval.
CHILD_CHUNK_SIZE=300
CHILD_CHUNK_OVERLAP=50

# Parent chunk: large, passed to the LLM as full context.
PARENT_CHUNK_SIZE=1500
PARENT_CHUNK_OVERLAP=200


# ── Database engine: set exactly one to true ──────────────────────────────────
# This toggle applies to BOTH databases below (operational + chat history).
USE_MYSQL=true
USE_MSSQL=false

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DB 1 — OPERATIONAL DATA  (Django alias: "default")
# Purpose : Stores the actual Seros rig/equipment/workforce data.
#           Used for analytics queries in Phase 2.
#           Django does NOT create tables here — it is read-only raw data.
# Dev     : MySQL — local copy converted from the MSSQL dump.
# Prod    : MSSQL — the live SQL Server on the rig network.
# Note    : Update MYSQL_DB once you receive and import the dump.
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=Seros_Data
MYSQL_USER=root
MYSQL_PASSWORD='Soham87654$'

MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DB=Seros_Data
MSSQL_USER=
MSSQL_PASSWORD=
# Run `odbcinst -q -d` to list installed ODBC drivers
MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server

# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# DB 2 — CHAT HISTORY  (Django alias: "chathistory")
# Purpose : Stores chatbot conversations and messages.
#           Django manages this DB — all tables are prefixed cb_
#           (cb_conversations, cb_messages).
# Dev     : MySQL — SerosIS database (already created and migrated).
# Prod    : MSSQL — can be a separate DB or the same as DB 1 (cb_ prefix
#           prevents any table name collisions with operational data).
# Migrate : python manage.py migrate --database=chathistory
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
CHAT_MYSQL_HOST=127.0.0.1
CHAT_MYSQL_PORT=3306
CHAT_MYSQL_DB=SerosIS
CHAT_MYSQL_USER=root
CHAT_MYSQL_PASSWORD='Soham87654$'

CHAT_MSSQL_HOST=localhost
CHAT_MSSQL_PORT=1433
CHAT_MSSQL_DB=SerosIS
CHAT_MSSQL_USER=
CHAT_MSSQL_PASSWORD=
CHAT_MSSQL_ODBC_DRIVER=ODBC Driver 17 for SQL Server


# --- Django ---
DJANGO_SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=True
